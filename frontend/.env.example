# Supabase — Pedir las keys a Thiago por DM
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Anthropic (para clasificacion IA) — Server-side only
ANTHROPIC_API_KEY=sk-ant-tu-key-aqui

# Site URL (debe coincidir con PUBLIC_SITE_URL del backend en VPS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prueba 1 Calendly: mismo PAT que en Conexiones → GET http://localhost:3000/api/calendly/verify-me
# CALENDLY_PERSONAL_ACCESS_TOKEN=
# En producción, solo si querés esta ruta: CALENDLY_VERIFY_ME_ENABLED=true

# Fathom (Conexiones) → GET http://localhost:3000/api/fathom/verify-me
# FATHOM_API_KEY=
# FATHOM_WEBHOOK_SECRET=
# FATHOM_VERIFY_ME_ENABLED=true

# ManyChat (page_id:api_key) → GET http://localhost:3000/api/manychat/verify-me
# MANYCHAT_API_KEY=
# MANYCHAT_VERIFY_ME_ENABLED=true

# Apify (reels scraper) → GET http://localhost:3000/api/apify/verify-me
# APIFY_API_TOKEN=
# APIFY_VERIFY_ME_ENABLED=true

# FastAPI: si lo dejas vacío, el frontend usa /api-backend (rewrite en next.config hacia BACKEND_INTERNAL_URL)
NEXT_PUBLIC_BACKEND_URL=
# Destino del rewrite (solo build/servidor Next, no se expone al navegador)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
